# =====================================================================================
#  QuandoPassa – configurazione       cp .env.example .env
#  Dopo ogni modifica:  docker compose up -d --force-recreate
#  I commenti vanno su righe proprie.
# =====================================================================================

# --- 1. FEED GTFS --------------------------------------------------------------------
# Cartella con i file GTFS (stops.txt, routes.txt, trips.txt, stop_times.txt, calendar.txt...).
# Percorso relativo alla radice del repository (docker compose la monta in sola lettura).
# Predefinito: le 20 aree della proposta pensiline, Circolari A e B (data).
# Per un altro feed: copiare i file in una cartella (es. data/altro) e cambiare questa riga.
GTFS_DIR=./data

# --- 2. SERVIZIO E COMUNE ------------------------------------------------------------
COMUNE_NOME=Comune di Gioia del Colle
SERVIZIO_NOME=Bus urbano di Gioia del Colle
# Centro iniziale della mappa (lat,lon)
MAPPA_CENTRO=40.7990,16.9230
# Risposta dell'assistente su biglietti e tariffe (testo ufficiale dell'ente)
INFO_BIGLIETTI=Tariffe e punti vendita dei biglietti: chiedere all'azienda di trasporto o all'Ufficio Trasporti del Comune.

# --- 3. MAPPA ------------------------------------------------------------------------
# Tile OpenStreetMap. Per traffico elevato usare un tile server proprio o un fornitore
# (la policy dei tile OSM non consente uso intensivo).
MAPPA_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAPPA_ATTRIBUZIONE=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# --- 4. INDIRIZZO PUBBLICO E RICERCA LUOGHI -----------------------------------------
BASE_URL=http://localhost:8000
# "Come arrivo": indirizzi e luoghi cercati dal server su Nominatim (OpenStreetMap), limitati al territorio.
# Al geocoder arriva solo il testo cercato. In esercizio meglio un'istanza dell'ente; vuoto = solo fermate.
LUOGHI_GEOCODER=https://nominatim.openstreetmap.org

# --- 5. BIGLIETTI (prototipo) ---------------------------------------------------------
# Acquisto anonimo: il biglietto resta sul telefono, il server ne conserva solo l'impronta.
BIGLIETTI_ATTIVI=true
# simulato = nessun denaro reale (prototipo) | pagopa = vende il Comune (MyPay SIL, da completare)
# gestore = vende l'azienda di trasporto con il suo circuito di pagamento (da completare)
PAGAMENTI=simulato
# Tariffe in euro (separatore . o ,) e regole dei titoli: usare quelle deliberate dall'ente.
TARIFFA_CORSA=1.00
VALIDITA_CORSA_MIN=60
TARIFFA_CARNET=9.00
CORSE_CARNET=10
TARIFFA_ABBONAMENTO=25.00
GIORNI_ABBONAMENTO=30
FONTE_TARIFFE=Tariffe di esempio del prototipo: da sostituire con quelle deliberate dall'ente.
# Firma dei QR dei biglietti.  PRODUZIONE: openssl rand -hex 32
BIGLIETTI_SEGRETO=sostituire-con-una-stringa-casuale
# Credenziali del controllore per la pagina /verifica (vuote = verifica disattivata)
VERIFICA_USER=controllore
VERIFICA_PASSWORD=cambiami

# --- 6. INTELLIGENZA ARTIFICIALE -----------------------------------------------------
# rules  = motore a regole in italiano, offline: nessun dato esce dal server (predefinito)
# openai = LLM compatibile OpenAI (Ollama del profilo "llm", vLLM, Azure OpenAI...)
#          che capisce frasi più libere e riformula le risposte; orari e minuti restano
#          quelli calcolati dall'app, le riformulazioni con numeri diversi vengono scartate.
INFERENCE_BACKEND=rules
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen2.5:1.5b-instruct
LLM_API_KEY=ollama
LLM_TIMEOUT=20

# --- 7. SERVER MCP (http://localhost:8090/mcp) ---------------------------------------
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*

# --- 8. DEMO -------------------------------------------------------------------------
# Orologio che parte da un istante fisso (ora di Roma), utile fuori orario di servizio.
# Vuoto = ora reale.
DEMO_ORA=
